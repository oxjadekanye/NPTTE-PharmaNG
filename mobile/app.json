{
  "expo": {
    "name": "NPTTE PharmaNG",
    "slug": "nptte-pharmang",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nptte",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0f1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.gov.nptte.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "NPTTE uses the camera to scan pharmaceutical serial numbers and QR codes.",
        "NSLocationWhenInUseUsageDescription": "Optional location helps anchor scan events for field operations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1a"
      },
      "package": "ng.gov.nptte.mobile",
      "permissions": ["CAMERA", "ACCESS_NETWORK_STATE", "INTERNET"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NPTTE to scan product barcodes and QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#38bdf8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api/v1"
    }
  }
}
