# NPTTE Backend — copy to backend/.env for local development
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key-for-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker local example)
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nptte_pharmang
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Render / production: set DATABASE_URL instead of individual DB_* vars
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Regulator seed (optional — python manage.py seed_regulator_admin)
# NPTTE_REGULATOR_USERNAME=nptte_admin
# NPTTE_REGULATOR_EMAIL=admin@nptte.gov.ng
# NPTTE_REGULATOR_PASSWORD=change-me-in-production
# NPTTE_REGULATOR_ROLE=NAFDAC_ADMIN

# Set to True to use SQLite for quick local bootstrap without PostgreSQL
# USE_SQLITE=True

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production only
# DJANGO_SETTINGS_MODULE=config.settings.production
# ALLOWED_HOSTS=your-app.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
